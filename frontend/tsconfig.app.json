{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@pixi/constants": ["./src/pixi-compat/constants.ts"],
      "@pixi/core": ["./src/pixi-compat/core.ts"],
      "@pixi/display": ["./src/pixi-compat/display.ts"],
      "@pixi/math": ["./src/pixi-compat/math.ts"],
      "@pixi/sprite": ["./src/pixi-compat/sprite.ts"],
      "@pixi/ticker": ["./src/pixi-compat/ticker.ts"]
    }
  },
  "include": ["src"]
}
