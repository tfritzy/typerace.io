rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /gameRecords/{recordId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.firebaseUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.firebaseUid == request.auth.uid;
    }
  }
}
